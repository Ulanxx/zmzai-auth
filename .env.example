NODE_ENV=development
APP_URL=http://localhost:3001
# 与 muzhi 同 Atlas、同 database（读它的 User/Session 表）
MONGODB_URI=mongodb+srv://.../muzhi_production
# 必须与 muzhi 完全一致
AUTH_SECRET=replace-with-same-as-muzhi-at-least-32-chars
SESSION_COOKIE_NAME=muzhi_session
# 父域共享，子域共用登录态
SESSION_COOKIE_DOMAIN=.zmzai.cloud
SESSION_TTL_DAYS=30
